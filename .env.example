# Copy this file to .env and fill in your own values.
# Never commit your real .env — it's already in .gitignore.

# Your school's Canvas URL, no trailing slash
# e.g. https://yourschool.instructure.com
CANVAS_BASE_URL=

# Canvas > Account > Settings > + New Access Token
CANVAS_API_TOKEN=

# Gmail address to send FROM (needs a 16-char App Password, not your login password:
# https://myaccount.google.com/apppasswords — requires 2-Step Verification enabled)
EMAIL_FROM=
GMAIL_APP_PASSWORD=

# Where to send the digest. Comma-separate multiple addresses. Defaults to EMAIL_FROM.
EMAIL_TO=

# IANA timezone name for "today"/"tomorrow" and due times, e.g. America/New_York
TIMEZONE=America/New_York

# If true (default), still sends an email even when nothing is due today/tomorrow
SEND_IF_EMPTY=true
